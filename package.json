{
  "name": "three-vpl-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter three-vpl build && pnpm docs:build",
    "docs:build": "pnpm --filter website build",
    "dev": "pnpm --filter website dev",
    "tsc": "pnpm -r --if-present typecheck",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:gpu": "node scripts/verify-demo.mjs",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "package:check": "node scripts/check-package.mjs",
    "prepare": "husky",
    "release": "semantic-release",
    "release:check": "node --test scripts/release.test.mjs"
  },
  "devDependencies": {
    "@anolilab/semantic-release-pnpm": "^8.1.29",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.13.5",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.83.0",
    "playwright": "^1.63.0",
    "semantic-release": "^25.0.9",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt",
      "oxlint --fix"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": "oxfmt"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.27.0"
}

    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "@types/react": "^19.2.0",
    "@types/three": "~0.186.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.186.0",
    "three-vpl": "workspace:*",
